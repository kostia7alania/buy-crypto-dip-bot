{
  "name": "@buy-crypto-dip-bot/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --out-dir dist --no-dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:postgres18": "REQUIRE_POSTGRES18_TEST=1 vitest run src/postgres18-contract.test.ts src/convergence.test.ts",
    "db:generate": "drizzle-kit generate --custom",
    "db:migrate": "pnpm build && node scripts/migrate.mjs",
    "db:verify-legacy-decision": "node scripts/validate-legacy-decision.mjs"
  },
  "dependencies": {
    "@buy-crypto-dip-bot/shared-types": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "catalog:",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
