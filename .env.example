# LOCAL DEV environment (copy to .env, gitignored).
# Production uses a separate file on the server — see .env.production.example
# and docs/13_VPS_DEPLOYMENT_RUNBOOK.md. Dev and prod credentials never mix.

# PostgreSQL (docker compose up -d starts a local instance with these creds)
APP_RUNTIME=local
POSTGRES_CONNECTION_STRING=postgresql://postgres:local_password@localhost:5432/dipbot

# Trading API
PORT=8787
API_URL=http://localhost:8787
# Shared secret between web BFF / bot and the API. Leave empty locally;
# REQUIRED on a VPS — without it the API is open to the internet.
API_KEY=
# Separate bot-to-API proof used only by the heartbeat endpoint. Leave empty
# locally; REQUIRED on a VPS. Never expose it to the web service or browser.
BOT_HEARTBEAT_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
# Optional Telegram user id that owns the one-time default strategy seed.
OPERATOR_TELEGRAM_USER_ID=
# Bot username (without @) — shows the Telegram Login button on the dashboard.
# Requires /setdomain in BotFather. Empty = login button hidden.
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Web session cookie encryption key (32+ chars). Optional locally —
# an ephemeral key is generated per boot, so sessions reset on restart.
SESSION_SECRET=

# Risk
EXECUTION_MODE=DRY_RUN
ALLOWLIST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
